{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "test"
  ],
  "references": [
    {
      "path": "../../packages/singularity/protocol/tsconfig.build.json"
    },
    {
      "path": "../../packages/singularity/runtime/tsconfig.build.json"
    }
  ]
}
