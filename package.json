{
  "name": "@singularity/v1-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "verify": "pnpm verify:project && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "verify:project": "node scripts/verify-project.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "build": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
